rules_version = '2';

service cloud.firestore {
  match /databases/{db}/documents {
    function profile() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data;
    }
    function superAdmin() {
      return request.auth != null && profile().role in ['Admin', 'Super Admin'];
    }
    function roleAllows(permission) {
      let role = profile().role;
      return permission in ['orders:read', 'orders:update', 'dispatch:read', 'tracking:publish', 'labor:read', 'labor:update'] && role in ['Lead', 'RegionalAdmin', 'OperationsAdmin']
        || permission in ['users:read', 'orders:create', 'reports:export'] && role in ['RegionalAdmin', 'OperationsAdmin']
        || permission in ['users:create', 'dispatch:override', 'tracking:view_all'] && role == 'OperationsAdmin';
    }
    function can(permission) {
      return request.auth != null && (superAdmin() || roleAllows(permission) || profile().get('permissions', []).hasAny(['*:*', permission]));
    }
    function inScope(regionId) {
      return superAdmin() || (regionId is string && profile().get('regions', []).hasAny(['*', regionId]));
    }
    function ownsCustomerTracking() {
      return request.auth != null && profile().role == 'User' && resource.data.customerUid == request.auth.uid;
    }
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || (can('users:read') && inScope(resource.data.get('regionId', ''))));

      // New browser accounts begin with the least-privileged role.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'User'
        && request.resource.data.keys().hasOnly(['email', 'role', 'createdAt', 'displayName']);

      allow create: if can('users:create') && request.resource.data.role == 'User'
        && request.resource.data.keys().hasOnly(['email', 'role', 'createdAt', 'displayName']);
      allow create: if can('roles:assign') && request.resource.data.role in ['OperationsAdmin', 'RegionalAdmin', 'Lead', 'Admin', 'Super Admin']
        && request.resource.data.keys().hasOnly(['email', 'role', 'createdAt', 'displayName', 'permissions', 'regions', 'regionId', 'workspaceId'])
        && (superAdmin() || (request.resource.data.role in ['OperationsAdmin', 'RegionalAdmin', 'Lead']
          && !request.resource.data.keys().hasAny(['permissions', 'workspaceId'])))
        && (!request.resource.data.keys().hasAny(['workspaceId']) || validWorkspaceId(request.resource.data.workspaceId));

      // Profile owners can edit their details, but cannot grant themselves roles.
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone']);

      allow update: if can('roles:assign') && request.resource.data.role in ['User', 'OperationsAdmin', 'RegionalAdmin', 'Lead']
        && !(resource.data.role in ['Admin', 'Super Admin'])
        && request.resource.data.keys().hasOnly(['email', 'role', 'createdAt', 'displayName', 'phone', 'permissions', 'regions', 'regionId', 'workspaceId'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissions', 'workspaceId']);
      allow update: if superAdmin() && request.resource.data.role in ['User', 'OperationsAdmin', 'RegionalAdmin', 'Lead', 'Admin', 'Super Admin']
        && request.resource.data.keys().hasOnly(['email', 'role', 'createdAt', 'displayName', 'phone', 'permissions', 'regions', 'regionId', 'workspaceId'])
        && (!request.resource.data.keys().hasAny(['workspaceId']) || validWorkspaceId(request.resource.data.workspaceId));

      // Deleting a profile would let its owner recreate it; use Admin SDK for removal.
      allow delete: if can('users:delete') && !(resource.data.role in ['Admin', 'Super Admin']);
    }

    function validWorkspaceId(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,128}$');
    }
    function workspaceMember(workspaceId) {
      let team = profile().get('workspaceId', '');
      return profile().role in ['Admin', 'Super Admin', 'OperationsAdmin', 'RegionalAdmin', 'Lead']
        && (validWorkspaceId(team)
          ? workspaceId == 'team-' + team
          : workspaceId == 'account-' + request.auth.uid);
    }

    match /sharedWorkspaces/{workspaceId}/records/{recordId} {
      function member() { return request.auth != null && workspaceMember(workspaceId); }
      function advancesRevision() {
        return getAfter(/databases/$(db)/documents/sharedWorkspaces/$(workspaceId)/records/revision).data.updatedAt == request.time;
      }
      function validRevision(value) {
        return request.resource.data.keys().hasOnly(['value', 'updatedAt'])
          && request.resource.data.value is int && request.resource.data.value == value
          && request.resource.data.updatedAt == request.time;
      }
      function validOrigin(record) {
        let origin = record.get('origin', '');
        return origin is string && (origin == '' || origin.matches('^[0-9a-f]{64}$'));
      }
      function linked(kind, id) {
        let key = kind + '-' + id;
        let path = /databases/$(db)/documents/sharedWorkspaces/$(workspaceId)/records/$(key);
        return validWorkspaceId(id) && getAfter(path).data.get('deleted', false) == false;
      }
      function optionalLink(kind, id) {
        return id == '' || id == null || linked(kind, id);
      }
      function validBody(kind, data) {
        return validWorkspaceId(data.id) && recordId == kind + '-' + data.id
          && (kind == 'crew' && data.name is string && data.title is string && data.rate is number && data.rate > 0
            || kind == 'delivery' && data.customer is string && data.address is string && data.notes is string
              && data.escalated is bool && data.events is list && data.scheduledDate is string && data.status in ['Pending', 'In Transit', 'Delivered']
              && optionalLink('crew', data.get('workerId', ''))
            || kind == 'hours' && validWorkspaceId(data.workerId) && data.date is string
              && data.hours is number && data.hours > 0 && data.hours <= 24 && data.rate is number && data.rate > 0
              && linked('crew', data.workerId) && optionalLink('delivery', data.get('deliveryId', '')));
      }
      function validRecord() {
        let record = request.resource.data;
        return record.keys().hasOnly(['kind', 'data', 'origin']) && record.data is map
          && validOrigin(record) && validBody(record.kind, record.data);
      }
      function canCreate(kind) {
        return kind == 'crew' && can('users:create') || kind == 'delivery' && can('orders:create') || kind == 'hours' && can('labor:update');
      }
      function validTombstone() {
        let old = resource.data;
        let next = request.resource.data;
        return next.keys().hasOnly(['kind', 'id', 'deleted', 'origin']) && next.deleted == true && next.id == old.data.id
          && (old.kind == 'delivery' && can('orders:cancel') || old.kind == 'hours' && can('labor:update'));
      }
      allow read: if member();
      allow create: if member() && (recordId == 'revision' ? validRevision(1)
        : advancesRevision() && validRecord() && canCreate(request.resource.data.kind));
      allow update: if member() && (recordId == 'revision' ? validRevision(resource.data.value + 1)
        : advancesRevision() && !resource.data.get('deleted', false)
          && request.resource.data.kind == resource.data.kind
          && request.resource.data.get('origin', '') == resource.data.get('origin', '')
          && (validTombstone() || (resource.data.kind == 'delivery' && can('orders:update') && validRecord())));
    }

    match /deliveries/{deliveryId} {
      allow read: if can('orders:read') && inScope(resource.data.regionId);
      allow create: if can('orders:create') && inScope(request.resource.data.regionId);
      allow update: if can('orders:update') && inScope(resource.data.regionId) && inScope(request.resource.data.regionId);
      allow delete: if can('orders:cancel') && inScope(resource.data.regionId);
    }
    match /customerTracking/{deliveryId} {
      function validTracking() {
        let d = request.resource.data;
        return d.keys().hasAll(['customerUid', 'address', 'scheduledDate', 'status', 'updatedAt', 'regionId'])
          && d.keys().hasOnly(['customerUid', 'address', 'scheduledDate', 'status', 'updatedAt', 'regionId'])
          && d.customerUid is string && d.customerUid.size() > 0 && d.customerUid.size() <= 128
          && d.address is string && d.address.size() > 0 && d.address.size() <= 240
          && d.scheduledDate is string && d.scheduledDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.status in ['Pending', 'In Transit', 'Delivered']
          && d.updatedAt == request.time;
      }
      allow read: if resource == null
        ? can('tracking:view_all')
        : ((can('tracking:view_all') && inScope(resource.data.regionId)) || ownsCustomerTracking());
      allow create: if can('tracking:publish') && inScope(request.resource.data.regionId) && validTracking()
        && get(/databases/$(db)/documents/users/$(request.resource.data.customerUid)).data.role == 'User';
      allow update: if can('tracking:publish') && inScope(resource.data.regionId) && validTracking() && request.resource.data.customerUid == resource.data.customerUid && request.resource.data.regionId == resource.data.regionId;
      allow delete: if can('tracking:delete')
        && (resource == null || inScope(resource.data.regionId));
      match /events/{eventId} {
        allow read: if (can('tracking:view_all') && inScope(get(/databases/$(db)/documents/customerTracking/$(deliveryId)).data.regionId)) || ownsCustomerTracking();
        allow create: if can('tracking:publish') && inScope(getAfter(/databases/$(db)/documents/customerTracking/$(deliveryId)).data.regionId)
          && request.resource.data.keys().hasAll(['status', 'at'])
          && request.resource.data.keys().hasOnly(['status', 'at'])
          && request.resource.data.status in ['Pending', 'In Transit', 'Delivered']
          && request.resource.data.at == request.time
          && getAfter(/databases/$(db)/documents/customerTracking/$(deliveryId)).data.status == request.resource.data.status
          && getAfter(/databases/$(db)/documents/customerTracking/$(deliveryId)).data.updatedAt == request.time;
        allow delete: if can('tracking:delete') && inScope(get(/databases/$(db)/documents/customerTracking/$(deliveryId)).data.regionId);
        allow update: if false;
      }
    }
  }
}
